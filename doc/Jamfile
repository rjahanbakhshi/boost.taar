import boostbook : boostbook ;
import doxygen : doxygen ;
import os ;
import path ;
import project ;
import quickbook ;

# Initialise the documentation toolsets. With no arguments these search
# PATH for doxygen / quickbook. boostbook reads the DocBook XSL and DTD
# locations from the DOCBOOK_XSL_DIR and DOCBOOK_DTD_DIR environment
# variables (also accepted as `-s` flags on the b2 command line). When
# unset, BoostBook falls back to downloading the stylesheets, which is
# very slow; install docbook-xsl / docbook-xml from your distro and
# point these at /usr/share/xml/docbook/xsl-stylesheets-* and
# /usr/share/xml/docbook/xml-dtd-4.2 respectively.
using doxygen ;
using quickbook ;
using boostbook
    : [ os.environ DOCBOOK_XSL_DIR ]
    : [ os.environ DOCBOOK_DTD_DIR ]
    ;

project taar/doc ;

path-constant INCLUDES : ../include ;

local doxygen-inputs =
    [ glob $(INCLUDES)/boost/taar/core/*.hpp ]
    [ glob $(INCLUDES)/boost/taar/handler/*.hpp ]
    [ glob $(INCLUDES)/boost/taar/matcher/*.hpp ]
    [ glob $(INCLUDES)/boost/taar/server/*.hpp ]
    [ glob $(INCLUDES)/boost/taar/session/*.hpp ]
    [ glob $(INCLUDES)/boost/taar/type_traits/*.hpp ]
    ;

# Generate a BoostBook-flavoured XML reference from the Doxygen comments
# on the public headers. The target name has no extension: the b2
# doxygen rule produces a corresponding `<name>.xml` stage target plus
# an alias under the bare name. main.qbk references the .xml file via
# [xinclude reference.xml]; the boostbook target below uses the alias
# via <dependency>reference.
doxygen reference
    : $(doxygen-inputs)
    : <doxygen:param>PROJECT_NAME=Boost.Taar
      <doxygen:param>JAVADOC_AUTOBRIEF=YES
      # AUTOLINK_SUPPORT=NO: BoostBook's docbook XSL predates C++20 and
      # does not emit anchors for concepts (or for many class-internal
      # members exposed via auto-linking). Leaving auto-linking on
      # produced "no ID for constraint linkend" errors at xsltproc time
      # for every bare mention of boost::taar::is_http_response,
      # is_matcher, etc. Disable it; cross-references can still be made
      # with explicit @ref where the target is known to render.
      <doxygen:param>AUTOLINK_SUPPORT=NO
      <doxygen:param>EXTRACT_ALL=NO
      <doxygen:param>EXTRACT_PRIVATE=NO
      <doxygen:param>EXTRACT_LOCAL_CLASSES=NO
      <doxygen:param>HIDE_UNDOC_MEMBERS=YES
      <doxygen:param>HIDE_UNDOC_CLASSES=YES
      <doxygen:param>HIDE_FRIEND_COMPOUNDS=YES
      <doxygen:param>SHOW_INCLUDE_FILES=YES
      <doxygen:param>INHERIT_DOCS=YES
      <doxygen:param>QUIET=YES
      <doxygen:param>WARN_IF_UNDOCUMENTED=NO
      <doxygen:param>WARN_NO_PARAMDOC=NO
      <doxygen:param>FILE_PATTERNS=*.hpp
      <doxygen:param>RECURSIVE=YES
      <doxygen:param>ENABLE_PREPROCESSING=YES
      <doxygen:param>MACRO_EXPANSION=YES
      <doxygen:param>EXPAND_ONLY_PREDEF=YES
      <doxygen:param>SEARCH_INCLUDES=NO
    ;

xml taar
    : main.qbk
    : <include>.
    ;

explicit taar ;

boostbook standalone
    : taar
    : <dependency>reference
      # boost.root locates the shared Boost doc assets: the boostbook
      # CSS, the boost.png logo, and the prev/up/home/next navigation
      # icons. For docs that live inside the boost.org tree this is a
      # relative path; for a standalone deployment (GitHub Pages here)
      # those assets aren't shipped, so point at the live boost.org
      # docs instead. Same approach libs/any uses.
      <xsl:param>boost.root=https://www.boost.org/doc/libs/release
      <xsl:param>nav.layout=none
      <xsl:param>boost.libraries=https://www.boost.org/doc/libs/
      <xsl:param>chapter.autolabel=1
      # chunk.section.depth=1: one HTML page per top-level chapter.
      # The Reference chapter therefore renders as a single page with
      # every header inline (rather than ~40 separate files that left
      # the Reference landing page empty and dumped the whole header
      # list onto the home page TOC).
      <xsl:param>chunk.section.depth=1
      <xsl:param>chunk.first.sections=1
      # toc.max.depth is an absolute depth from the document root. At 1
      # the home/library TOC lists only the top-level chapters and never
      # recurses into the Reference chapter's per-header subsections, so
      # the overview is visible without scrolling past a wall of links.
      <xsl:param>toc.section.depth=1
      <xsl:param>toc.max.depth=1
      <xsl:param>generate.section.toc.level=1
      <xsl:param>"generate.toc=chapter toc,title section nop reference nop"
      <format>html:<xsl:param>admon.graphics.path=images/
      <format>html:<xsl:param>img.src.path=images/
    ;

###############################################################################
# Build everything by default.
alias docs : standalone ;
explicit docs ;
